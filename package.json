{
  "name": "operon-agents-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r --parallel clean",
    "build:clean": "pnpm clean && pnpm -r --workspace-concurrency=1 build",
    "version:set": "node scripts/set-version.mjs",
    "typecheck": "pnpm build && pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "evals": "pnpm --filter operon-agents-core evals",
    "evals:selftest": "pnpm --filter operon-agents-core evals:selftest",
    "pack:all": "pnpm --filter operon-agents-core --filter operon-agents --filter operon-agents-peers --filter operon-sandbox --filter operon-os-sandbox --filter operon-managed-agents exec pnpm pack --out ../../dist-tarballs/%s-%v.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/picomatch": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
