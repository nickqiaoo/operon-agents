# ── The analyst server (pnpm server) ────────────────────────────────────────
# Model credentials for the provider named in MODEL (default anthropic/claude-opus-4-8).
ANTHROPIC_API_KEY=sk-ant-...
# MODEL=anthropic/claude-opus-4-8

# Web search needs a provider key; without one the analyst can only fetch URLs you name.
# Firecrawl serves both search and fetch; Tavily is search-only (fetch falls back to direct HTTP).
# FIRECRAWL_API_KEY=fc-...
# TAVILY_API_KEY=tvly-...

# Where the managed-agents API listens. Loopback-only unless MANAGED_API_KEY is set.
# MANAGED_PORT=8088
# MANAGED_HOST=127.0.0.1
# MANAGED_API_KEY=

# ── The chat app (pnpm dev) ─────────────────────────────────────────────────
# The managed-agents API the bridge talks to; MANAGED_API_KEY above is sent as a bearer token.
# OPERON_MANAGED_URL=http://127.0.0.1:8088/v1

# Where the chat page listens. The default is loopback-only because the demo trusts every
# caller; set HOST=0.0.0.0 only after wiring real auth into src/bot.ts.
# PORT=3000
# HOST=127.0.0.1
# Absolute origin of the chat page, for links rendered into native chat cards (Slack, Teams).
# PUBLIC_URL=http://127.0.0.1:3000
