{
  "name": "operon-example-chat-sdk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "server": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "test": "node --env-file-if-exists=.env --import tsx test/bridge.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/react": "^4",
    "@chat-adapter/state-memory": "4.34.0",
    "@chat-adapter/web": "4.34.0",
    "@hono/node-server": "^1",
    "ai": "^7",
    "chat": "4.34.0",
    "esbuild": "^0.25",
    "hono": "^4",
    "operon-agents": "workspace:*",
    "operon-managed-agents": "workspace:*",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10",
    "tsx": "^4"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  }
}
