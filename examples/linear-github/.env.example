# ── The engineer server (pnpm server) ───────────────────────────────────────
# Model credentials for the provider named in MODEL (default anthropic/claude-opus-4-8).
ANTHROPIC_API_KEY=sk-ant-...
# MODEL=anthropic/claude-opus-4-8

# Credentials the SERVER uses for git clone/push and for opening PRs -- a GitHub App
# installation (recommended: short-lived tokens, "your-app[bot]" authorship) ...
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"
GITHUB_INSTALLATION_ID=12345678
# ... or a personal access token with `repo` scope for a quick start.
# GITHUB_TOKEN=ghp_...

# Run every session in its own E2B sandbox (https://e2b.dev) instead of a directory on this
# host. The clone, the shell and every edit happen in the sandbox; it is paused between turns.
# E2B_API_KEY=e2b_...
# E2B_TEMPLATE=            # image for new sandboxes; the default has git
# E2B_TIMEOUT_MS=900000    # inactivity timeout while a session holds the sandbox open

# Trace every session to Langfuse (https://langfuse.com): one trace per run, one Langfuse session
# per Linear session, the model's messages and tool calls on the spans, secrets masked.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # EU (default); https://us.cloud.langfuse.com; or self-hosted
# LANGFUSE_TRACE_CONTENT=delta                    # none | delta | full -- how much conversation the spans carry

# Where the managed-agents API listens. Loopback-only unless MANAGED_API_KEY is set.
# MANAGED_PORT=8088
# MANAGED_HOST=127.0.0.1
# MANAGED_API_KEY=

# ── The bot (pnpm dev) ──────────────────────────────────────────────────────
# The managed-agents API the bridge talks to; MANAGED_API_KEY above is sent as a bearer token.
# OPERON_MANAGED_URL=http://127.0.0.1:8088/v1

# Which repository an issue is worked in: its label in Linear's "repo" label group, as
# "owner/name" or just "name" under this repository's owner. Issues without one get this
# repository; leave it unset to require the label.
GITHUB_REPO=your-org/your-repo
# LINEAR_REPO_LABEL_GROUP=repo

# Linear: an OAuth application installed with actor=app (see README "Linear setup").
# Single-tenant client credentials are the simplest; multi-tenant OAuth installs and personal
# API keys work too (see @chat-adapter/linear).
LINEAR_CLIENT_CREDENTIALS_CLIENT_ID=...
LINEAR_CLIENT_CREDENTIALS_CLIENT_SECRET=...
LINEAR_CLIENT_CREDENTIALS_SCOPES=read,write,comments:create,issues:create,app:mentionable,app:assignable
LINEAR_WEBHOOK_SECRET=...
# The app's name in Linear, for @-mention detection.
LINEAR_BOT_USERNAME=operon

# GitHub: the same App as above receives PR comment webhooks (the adapter reads GITHUB_APP_ID,
# GITHUB_PRIVATE_KEY and GITHUB_INSTALLATION_ID from the server section) ...
GITHUB_WEBHOOK_SECRET=...
# ... and needs the App's bot login to know when it is mentioned ("@operon-bot").
GITHUB_BOT_USERNAME=operon-bot[bot]

# Where the bot listens for webhooks. Expose it (a tunnel in development) and point both
# webhooks at https://<public-host>/api/webhooks/{linear,github}.
# PORT=3000
# HOST=0.0.0.0
