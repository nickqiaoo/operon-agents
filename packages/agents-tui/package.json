{
  "name": "operon-agents-tui",
  "version": "0.0.0",
  "private": true,
  "description": "A terminal client for operon-agents, built on operon-pi-tui and wired only through the public Harness API.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "operon-tui": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test --experimental-transform-types --no-warnings \"test/**/*.test.ts\"",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "operon-agents": "workspace:*",
    "operon-pi-tui": "workspace:*",
    "smol-toml": "^1.4.1",
    "zod": "^4.1.0"
  },
  "optionalDependencies": {
    "@mariozechner/clipboard": "^0.3.9"
  }
}
