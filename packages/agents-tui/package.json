{
  "name": "operon-agents-tui",
  "version": "0.0.0",
  "private": true,
  "description": "A terminal client for operon-agents, built on @earendil-works/pi-tui and wired only through the public Harness API. Used for internal debugging.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "operon-tui": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter operon-agents build && tsc -p tsconfig.build.json && chmod +x dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-transform-types --no-warnings --test test/*.test.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.84.1",
    "chalk": "^5.6.2",
    "operon-agents": "workspace:*"
  }
}
